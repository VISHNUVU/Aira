{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the Aria main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/aria-sidecar",
          "sidecar": true,
          "args": ["--engine", "auto", "--port", "0"]
        },
        {
          "name": "python3",
          "cmd": "python3",
          "args": true
        }
      ]
    }
  ]
}
